rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: salon_config
// Document IDs: 'info', 'wings', 'artworks_bundle', 'guestbook_bundle'
// Fields:
//   - info: {
//       name: string (required, 1-200 chars),
//       edition: string (required, 1-300 chars),
//       year: number (required, positive integer),
//       organizedBy: string (required, 1-200 chars),
//       school: string (required, 1-200 chars),
//       officialUrl: string (optional, URL, <= 500 chars),
//       iaapResultsUrl: string (optional, URL, <= 500 chars),
//       catalogPdfUrl: string (optional, URL, <= 1000 chars),
//       catalogPdfName: string (optional, <= 200 chars),
//       patronageList: list of maps (optional, <= 50 items),
//       patronages: map (optional),
//       totalSubmissions: number (optional, >= 0),
//       acceptedCount: number (optional, >= 0),
//       countriesRepresented: number (optional, >= 0),
//       juryChair: string (optional, <= 200 chars),
//       judges: list of maps (optional, <= 50 items),
//       updatedAt: number | timestamp (optional)
//     }
//   - wings: {
//       wings: list of category wing maps (required, <= 100 items),
//       updatedAt: number | timestamp (optional)
//     }
//   - artworks_bundle: {
//       artworks: list of artwork maps (required, <= 1000 items),
//       updatedAt: number | timestamp (optional)
//     }
//   - guestbook_bundle: {
//       entries: list of guestbook entries (required, <= 2500 items),
//       updatedAt: number | timestamp (optional)
//     }
//
// Collection: artworks
// Document ID: [artworkId] (string, 1-100 chars)
// Fields:
//   - title: string (required, 1-300 chars)
//   - photographer: string (required, 1-200 chars)
//   - category: string (required, 1-100 chars)
//   - imageUrl: string (required, URL, 1-2000 chars)
//   - awardTier: string (optional, 1-100 chars)
//   - school: string (optional, <= 200 chars)
//   - place: string (optional, <= 150 chars)
//   - country: string (optional, <= 100 chars)
//   - countryCode: string (optional, <= 10 chars)
//   - photographerHonors: string (optional, <= 150 chars)
//   - aspectRatio: number (optional, > 0)
//   - description: string (optional, <= 5000 chars)
//   - curatorNote: string (optional, <= 5000 chars)
//   - thumbnailUrl: string (optional, URL, <= 2000 chars)
//   - isHero: bool (optional)
//   - position: list of numbers (optional, size <= 4)
//   - rotationY: number (optional)
//   - wallSide: string (optional, <= 20 chars)
//   - exif: map (optional)
//
// Collection: wings
// Document ID: [wingId] (string, 1-100 chars)
// Fields:
//   - name: string (required, 1-200 chars)
//   - description: string (required, 1-3000 chars)
//   - iconName: string (optional, <= 100 chars)
//   - colorHex: string (optional, <= 30 chars)
//   - zStart: number (optional)
//   - zEnd: number (optional)
//   - awards: list of maps (optional, <= 50 items)
//
// Collection: guestbook
// Document ID: [entryId] (string, 1-100 chars)
// Fields:
//   - author: string (required, 1-100 chars)
//   - message: string (required, 1-1500 chars)
//   - timestamp: number | timestamp (required, > 0)
//   - country: string (optional, <= 100 chars)
//   - rating: number (optional, 1-5)
//   - id: string (optional, <= 100 chars)
//   - avatarColor: string (optional, <= 30 chars)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated via Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user is an authorized curator admin
    function isCurator() {
      return isAuthenticated();
    }

    // Validate that required fields exist in request payload
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that only allowed fields are present in request payload
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate string length bounds
    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    // Validate optional string length bounds
    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is string &&
         request.resource.data[field].size() >= minLen &&
         request.resource.data[field].size() <= maxLen);
    }

    // Validate URL format and length limit
    function isValidUrl(url) {
      return url is string &&
        url.size() <= 2000 &&
        (url.matches("^https://.*") || url.matches("^http://.*"));
    }

    // Validate optional URL
    function isValidOptionalUrl(field) {
      return !(field in request.resource.data) ||
        isValidUrl(request.resource.data[field]);
    }

    // Validate list type and enforce size bounds
    function isValidList(listVal, maxSize) {
      return listVal is list && listVal.size() <= maxSize;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    // Validates a single Guestbook entry document (e.g. /guestbook/{entryId})
    function isValidGuestbookEntry(data) {
      return data.keys().hasAll(['author', 'message', 'timestamp']) &&
        data.keys().hasOnly(['id', 'author', 'country', 'message', 'timestamp', 'rating', 'avatarColor']) &&
        data.author is string && data.author.size() >= 1 && data.author.size() <= 100 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 1500 &&
        ((data.timestamp is timestamp) || (data.timestamp is number && data.timestamp > 0)) &&
        (!('id' in data) || (data.id is string && data.id.size() >= 1 && data.id.size() <= 100)) &&
        (!('country' in data) || (data.country is string && data.country.size() >= 1 && data.country.size() <= 100)) &&
        (!('rating' in data) || (data.rating is number && data.rating >= 1 && data.rating <= 5)) &&
        (!('avatarColor' in data) || (data.avatarColor is string && data.avatarColor.size() <= 30));
    }

    // Validates the guestbook bundle inside salon_config/guestbook_bundle
    function isValidGuestbookBundle(data) {
      return data.keys().hasAll(['entries']) &&
        data.keys().hasOnly(['entries', 'updatedAt']) &&
        data.entries is list &&
        data.entries.size() <= 2500 &&
        (!('updatedAt' in data) || data.updatedAt is timestamp || (data.updatedAt is number && data.updatedAt > 0));
    }

    // Validates an individual Artwork document in /artworks/{artworkId}
    function isValidArtwork(data) {
      return data.keys().hasAll(['title', 'photographer', 'category', 'imageUrl']) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 300 &&
        data.photographer is string && data.photographer.size() >= 1 && data.photographer.size() <= 200 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 100 &&
        isValidUrl(data.imageUrl) &&
        (!('id' in data) || (data.id is string && data.id.size() <= 100)) &&
        (!('awardTier' in data) || (data.awardTier is string && data.awardTier.size() <= 100)) &&
        (!('school' in data) || (data.school is string && data.school.size() <= 200)) &&
        (!('place' in data) || (data.place is string && data.place.size() <= 150)) &&
        (!('country' in data) || (data.country is string && data.country.size() <= 100)) &&
        (!('countryCode' in data) || (data.countryCode is string && data.countryCode.size() <= 10)) &&
        (!('photographerHonors' in data) || (data.photographerHonors is string && data.photographerHonors.size() <= 150)) &&
        (!('aspectRatio' in data) || (data.aspectRatio is number && data.aspectRatio > 0)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 5000)) &&
        (!('curatorNote' in data) || (data.curatorNote is string && data.curatorNote.size() <= 5000)) &&
        (!('thumbnailUrl' in data) || isValidUrl(data.thumbnailUrl)) &&
        (!('isHero' in data) || (data.isHero is bool)) &&
        (!('rotationY' in data) || (data.rotationY is number)) &&
        (!('wallSide' in data) || (data.wallSide is string && data.wallSide.size() <= 20)) &&
        (!('position' in data) || (data.position is list && data.position.size() <= 4)) &&
        (!('exif' in data) || (data.exif is map));
    }

    // Validates an individual Wing document in /wings/{wingId}
    function isValidWing(data) {
      return data.keys().hasAll(['name', 'description']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
        data.description is string && data.description.size() <= 3000 &&
        (!('id' in data) || (data.id is string && data.id.size() <= 100)) &&
        (!('iconName' in data) || (data.iconName is string && data.iconName.size() <= 100)) &&
        (!('colorHex' in data) || (data.colorHex is string && data.colorHex.size() <= 30)) &&
        (!('zStart' in data) || (data.zStart is number)) &&
        (!('zEnd' in data) || (data.zEnd is number)) &&
        (!('awards' in data) || (data.awards is list && data.awards.size() <= 50));
    }

    // ===============================================================
    // Collection Match Rules
    // ===============================================================

    // 1. Salon Configuration Bundle Documents
    // Covers: 'info', 'wings', 'artworks_bundle', 'guestbook_bundle'
    match /salon_config/{document} {
      // Public visitors can view all salon configurations
      allow read: if true;

      // Curators have full write permissions across all configuration documents.
      // Visitors can create or update the guestbook_bundle document with strict validation.
      allow create: if isCurator() ||
        (document == 'guestbook_bundle' && isValidGuestbookBundle(request.resource.data));

      allow update: if isCurator() ||
        (document == 'guestbook_bundle' && isValidGuestbookBundle(request.resource.data));

      // Only authenticated curators can delete salon configurations
      allow delete: if isCurator();
    }

    // 2. Individual Artworks Collection
    match /artworks/{artworkId} {
      // Public visitors can view all artworks in the virtual exhibition
      allow read: if true;

      // Authenticated curators have full write/update/delete permissions
      allow create: if isCurator() && isValidArtwork(request.resource.data);
      allow update: if isCurator() && isValidArtwork(request.resource.data);
      allow delete: if isCurator();
    }

    // 3. Category Wings Collection
    match /wings/{wingId} {
      // Public visitors can view all exhibition wings/sections
      allow read: if true;

      // Authenticated curators have full write/update/delete permissions
      allow create: if isCurator() && isValidWing(request.resource.data);
      allow update: if isCurator() && isValidWing(request.resource.data);
      allow delete: if isCurator();
    }

    // 4. Guestbook Ledger Entries Collection
    match /guestbook/{entryId} {
      // Public visitors can read guestbook signatures
      allow read: if true;

      // Public visitors can sign the guestbook with appropriate validation
      allow create: if isValidGuestbookEntry(request.resource.data);

      // Only curators can moderate, update, or remove guestbook signatures
      allow update: if isCurator() && isValidGuestbookEntry(request.resource.data);
      allow delete: if isCurator();
    }

    // Default Deny for any unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
