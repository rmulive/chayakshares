rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Salon Configuration: info, wings, artworks_bundle, guestbook_bundle
    match /salon_config/{document} {
      allow read: if true;
      allow write: if true;
    }

    // Individual Artworks
    match /artworks/{document} {
      allow read: if true;
      allow write: if true;
    }

    // Wings & Sections
    match /wings/{document} {
      allow read: if true;
      allow write: if true;
    }

    // Guestbook Signatures
    match /guestbook/{document} {
      allow read: if true;
      allow write: if true;
    }
  }
}
